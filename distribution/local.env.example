# FluentFlow Local 环境变量模板
#
# 使用时复制为 .env 再按需取消注释。
#
# 所有变量都是可选的：不配置任何变量也能启动，AI/飞书凭据可以启动后在
# 设置页里填写。这里只包含本地版允许的变量，云端版专属设置不会出现。

# ----- 常用设置 -----

# 笔记生成用的 AI 服务：deepseek（默认）/ openai / qwen
# AI_PROVIDER=

# DeepSeek API Key（也可以启动后在设置页填写）
# DEEPSEEK_API_KEY=

# OpenAI API Key（可选）
# OPENAI_API_KEY=

# 阿里云百炼 / DashScope API Key（Qwen 与自动配图需要）
# DASHSCOPE_API_KEY=

# Anthropic API Key（可选）。「结合画面的笔记」默认用本机已登录的 Claude Code，不需要这个 Key；只有这台机器没装 Claude Code 时才需要填。两条路都走不通时功能会明确说不可用，不会改用别的模型
# ANTHROPIC_API_KEY=

# 飞书自建应用 App ID（导出到飞书文档需要）
# LARK_APP_ID=

# 飞书自建应用 App Secret
# LARK_APP_SECRET=

# pyannote 令牌（本地讲话人分离；已用 scripts/fetch_diarization_models.py 放好模型文件时不需要）
# PYANNOTE_AUTH_TOKEN=

# 本地讲话人分离的模型目录；默认在运行数据目录下的 models/pyannote，由 scripts/fetch_diarization_models.py 填充
# FLUENTFLOW_DIARIZATION_MODEL_DIR=

# 下载需登录的视频时复用哪个浏览器的登录态：chrome/safari/edge/firefox/brave
# YT_DLP_COOKIES_FROM_BROWSER=

# Agent API 访问令牌；不设置则 /agent/v1 整体关闭
# FLUENTFLOW_ACCESS_TOKEN=

# 运行数据目录；默认在系统应用数据目录（macOS: ~/Library/Application Support/FluentFlow）
# FLUENTFLOW_DATA_DIR=

# 监听地址，默认 127.0.0.1（仅本机）
# FLUENTFLOW_LOCAL_HOST=

# 监听端口，默认 8000
# FLUENTFLOW_LOCAL_PORT=

# ----- 其他可选项（进阶，按需取消注释） -----

